# --- ML / training artifacts ---
# Trained models, checkpoints, and experiment tracking output. Retrain/regenerate
# rather than committing binary weights; large flight datasets belong outside git
# (or in git-lfs / external storage) rather than in the repo.
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.onnx
*.pb
*.pkl
*.pickle
checkpoints/
runs/
lightning_logs/
wandb/
mlruns/
.tensorboard/

# --- Flight logs / data ---
# Raw/processed flight data and simulated trajectory datasets — regenerate or
# fetch from external storage rather than committing to git.
data/
datasets/
logs/
*.csv
*.parquet
*.npz
*.npy

